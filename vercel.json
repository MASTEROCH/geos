{
 "cleanUrls": false,
 "headers": [
  {
   "source": "/cities/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  }
 ]
}