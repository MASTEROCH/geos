{
 "cleanUrls": false,
 "functions": {
  "api/area.js": {
   "maxDuration": 30
  }
 },
 "rewrites": [
  {
   "source": "/p/(.*)",
   "destination": "/api/card?id=$1"
  },
  {
   "source": "/c/:cc/:slug",
   "destination": "/api/city?cc=:cc&slug=:slug"
  }
 ],
 "headers": [
  {
   "source": "/cities/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  },
  {
   "source": "/api/(og|venue|street|recommend|event|leads|mcp|own)(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "private, no-store"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate, s-maxage=300"
    }
   ]
  },
  {
   "source": "/earth/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=2592000, immutable"
    }
   ]
  }
 ]
}