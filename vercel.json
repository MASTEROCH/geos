{
 "cleanUrls": false,
 "rewrites": [
  {
   "source": "/p/(.*)",
   "destination": "/api/card?id=$1"
  }
 ],
 "headers": [
  {
   "source": "/cities/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  },
  {
   "source": "/api/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "private, no-store"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate, s-maxage=300"
    }
   ]
  }
 ]
}